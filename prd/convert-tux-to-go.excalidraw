      "seed": 792776976,
      "version": 747,
      "versionNonce": 1050268367,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788642995629,
      "link": null,
      "locked": false,
      "text": "These refer to the thinking parts where we (or the LLM) has to make a \ndecision based upon the context provided to it. ",
      "fontSize": 36,
