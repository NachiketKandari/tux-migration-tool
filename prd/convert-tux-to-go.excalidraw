      "link": null,
      "locked": false,
      "text": "These refer to the templates that I'll hard-code for functions.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "These refer to the templates that I'll hard-code for functions.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ezXi85sJyoXI2T25pIzgT",
      "type": "text",
      "x": 2063.1909089002547,
      "y": -905.9053196283326,
      "width": 1385.9990234375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zjYGfUpRvmc53PYpjNNcJ"
      ],
      "frameId": null,
      "index": "b8H",
      "roundness": null,
      "seed": 2127147792,
      "version": 836,
      "versionNonce": 2128068783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788642995629,
      "link": null,
      "locked": false,
      "text": "These refer to Vector DBs where relevant codebase data will be stored.\nVector DBs help in retrieving similar chunks (functions, text, etc..)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "These refer to Vector DBs where relevant codebase data will be stored.\nVector DBs help in retrieving similar chunks (functions, text, etc..)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HroHKDwPakPugxEkjRc1S",
