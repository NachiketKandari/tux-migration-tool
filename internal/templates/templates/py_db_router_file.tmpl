"""{{.RouterClass}} — the wrapper surface the generated batchpy modules import.

Generated by tuxconv batchpy (template set tuxconv py v1). This file is the
production half of the db-router contract; pygentest's harness carries a fake
with the same surface, and the two are kept in step by a compile-check pinned
against this template — not by goodwill.

The contract the generated modules rely on (every `with` block the batchpy
templates emit was written against it):

  - `{{.RouterClass}}()` is constructible with no arguments and connects
    lazily — constructing one never touches the network, so a module that is
    only imported or introspected does not open a pool.
  - `get_connection(mode=…)` is a context manager. A clean exit commits
    (WRITE) or releases (READ); an exception rolls back (WRITE) and
    re-raises. One block == one transaction — that is the atomicity contract
    the batch rubric builds on, not an implementation detail.
  - `conn.cursor()` yields a cursor supporting `execute(sql, binds=None)`,
    `rowcount`, `fetchone()` and `fetchall()`.
  - `{{.ModeClass}}` exposes the members the plan's emitters reference:
    {{- range $m := .ModeMembers}} {{$.ModeClass}}.{{$m}},{{- end}}

Configuration is read from the environment at first use, never at module
import: TUX_DB_USER / TUX_DB_PASSWORD / TUX_DB_DSN.
"""
import os
from contextlib import contextmanager
from enum import Enum
from typing import Any, Iterator, Optional

import oracledb


class {{.ModeClass}}(Enum):
    """Connection intent. WRITE owns a transaction; READ borrows a connection."""

{{- range $m := .ModeMembers}}
    {{$m}} = "{{$m}}"
{{- end}}


class {{.RouterClass}}:
    """Borrows pooled connections per operation, mode-routed.

    One `get_connection()` block is one transaction: the context manager
    commits on a clean exit and rolls back on an exception. Batch modules
    therefore open one block per record — a record's failure rolls back
    exactly that record, never the run's earlier records.
    """

    def __init__(self, user: Optional[str] = None, password: Optional[str] = None,
                 dsn: Optional[str] = None, min_pool: int = 1, max_pool: int = 4):
        self._user = user if user is not None else os.getenv("TUX_DB_USER")
        self._password = password if password is not None else os.getenv("TUX_DB_PASSWORD")
        self._dsn = dsn if dsn is not None else os.getenv("TUX_DB_DSN")
        self._pool_size = (min_pool, max_pool)
        self._pool: Optional[Any] = None

    def _pool_or_raise(self) -> Any:
        """Lazily create the session pool at first use, not at construction."""
        if self._pool is None:
            if not (self._user and self._password and self._dsn):
                raise RuntimeError(
                    "database not configured: set TUX_DB_USER, TUX_DB_PASSWORD "
                    "and TUX_DB_DSN (or pass user/password/dsn to the router)")
            self._pool = oracledb.create_pool(
                user=self._user, password=self._password, dsn=self._dsn,
                min=self._pool_size[0], max=self._pool_size[1], increment=1)
        return self._pool

    @contextmanager
    def get_connection(self, mode: Optional[Any] = None) -> Iterator[Any]:
        """Yield one pooled connection; commit on clean WRITE exit, rollback on error."""
        pool = self._pool_or_raise()
        conn = pool.acquire()
        try:
            yield conn
            if mode == {{.WriteModeExpr}}:
                conn.commit()
        except Exception:
            if mode == {{.WriteModeExpr}}:
                conn.rollback()
            raise
        finally:
            pool.release(conn)
