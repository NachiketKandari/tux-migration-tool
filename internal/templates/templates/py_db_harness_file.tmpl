class {{.RouterClass}}:
    """The recording fake of the production router: one block, one transaction.

    `pending` is the FIFO of SELECT results (see _Cursor). `fail_on` is a
    substring or a callable(statement, binds), and a matching statement raises
    DatabaseError from execute — the injection point for failure-path tests.
    `rowid` is what RETURNING binds receive; `rowcount` answers DML.
    """

    def __init__(self, pending=(), rowid="AAAPecAAEAAAACHAAA", fail_on=None, rowcount=1):
        self.pending = list(pending)
        self.rowid = rowid
        self.fail_on = fail_on
        self.default_rowcount = rowcount
        self.log = []
        self.txn_ends = []
        self.commits = []
        self.rollbacks = []
        self.modes = {}
        self._n = 0

    @contextmanager
    def get_connection(self, mode=None):
        self._n += 1
        txn = self._n
        conn = _Connection(self, txn, mode)
        self.modes[txn] = mode
        try:
            yield conn
        except Exception:
            if mode == {{.WriteModeExpr}}:
                conn.rollback()
            self.txn_ends.append((txn, True))
            raise
        else:
            if mode == {{.WriteModeExpr}}:
                conn.commit()
            self.txn_ends.append((txn, False))

    def txs(self):
        """txn_id -> [normalised statements], in execution order."""
        out = {}
        for txn, statement, _ in self.log:
            out.setdefault(txn, []).append(statement)
        return out

    def sqls(self):
        """Every normalised statement executed, in order."""
        return [statement for _, statement, _ in self.log]

    def _take_rows(self):
        if not self.pending:
            return []
        item = self.pending.pop(0)
        return list(item) if isinstance(item, list) else [item]

    def _should_fail(self, statement, binds):
        if self.fail_on is None:
            return False
        if callable(self.fail_on):
            return bool(self.fail_on(statement, binds))
        return self.fail_on in statement


def normalise(sql):
    """Whitespace-collapse a statement the way every assertion compares it."""
    return re.sub(r"\s+", " ", sql).strip()


def _unmodelled_driver_name(name):
    raise AttributeError(
        "pygentest harness: oracledb." + name + " is not modelled — add it to "
        "install() if the generated code needs it")


def install():
    """Shadow `oracledb` and `core.db_router` in sys.modules with the fakes.

    Deterministic on purpose: the harness always installs its own stubs, so a
    suite cannot accidentally talk to a real driver or to the production
    router file on sys.path. Returns the oracledb stub.
    """
    oracledb = types.ModuleType("oracledb")
    oracledb.__doc__ = "pygentest harness stub for python-oracledb"
    oracledb.DatabaseError = DatabaseError
    oracledb.Cursor = _Cursor
    oracledb.STRING = "STRING"
    oracledb.NUMBER = "NUMBER"
    oracledb.DATE = "DATE"
    oracledb.TIMESTAMP = "TIMESTAMP"
    oracledb.__getattr__ = _unmodelled_driver_name
    sys.modules["oracledb"] = oracledb

    core = types.ModuleType("core")
    db_router = types.ModuleType("core.db_router")
    db_router.__doc__ = "pygentest harness fake for the production db-router contract"
    db_router.{{.RouterClass}} = {{.RouterClass}}
    db_router.{{.ModeClass}} = {{.ModeClass}}
    core.db_router = db_router
    sys.modules["core"] = core
    sys.modules["core.db_router"] = db_router
    return oracledb


def load(path, name=None):
    """Import a generated module by file path, with the fakes installed.

    The module lands in sys.modules under its own stem (or `name`) before it
    executes, so nested imports and repr() behave like a normal import. Call
    this instead of `import <module>`: it is the only path that installs the
    fakes first, and importing the production core.db_router before it would
    require a live driver.
    """
    install()
    path = os.path.abspath(path)
    if name is None:
        name = os.path.splitext(os.path.basename(path))[0]
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise ImportError("pygentest harness: cannot load " + path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


class Suite:
    """The minimal stdlib-only check runner the generated suites exit through.

    A suite that does not finish() and sys.exit() its code is not a gate; the
    pygentest command runs it with python3 and fails the build on a non-zero
    exit (the plan's guard against golden-stamping: the suite must execute).

    `skip` exists so a claim the suite cannot decide today is REPORTED rather
    than passed over: a skipped check prints, is counted, and never becomes a
    green tick. `extra` is the machine read-out the command parses off the
    PYGENTEST-RESULT line (findings, tier counts).
    """

    def __init__(self, name="pygentest"):
        self.name = name
        self.passed = []
        self.failed = []
        self.skipped = []
        self.extra = {}

    def section(self, title):
        print("\n=== %s ===" % title)

    def check(self, label, condition, detail=""):
        if condition:
            self.passed.append(label)
            print("  [PASS] %s" % label)
        else:
            self.failed.append(label)
            print("  [FAIL] %s%s" % (label, "  (%s)" % detail if detail else ""))
        return bool(condition)

    def eq(self, label, got, want):
        return self.check(label, got == want, "got %r, want %r" % (got, want))

    def skip(self, label, why):
        """Record an assertion the suite cannot decide — never a pass."""
        self.skipped.append(label)
        print("  [SKIP] %s  (%s)" % (label, why))
        return False

    def result(self):
        """The machine read-out: one JSON object on one line."""
        payload = {
            "suite": self.name,
            "checks": len(self.passed) + len(self.failed),
            "passed": len(self.passed),
            "failed": len(self.failed),
            "skipped": len(self.skipped),
            "failed_checks": self.failed,
        }
        payload.update(self.extra)
        return json.dumps(payload, sort_keys=True)

    def finish(self):
        total = len(self.passed) + len(self.failed)
        print("\n%s: %d checks, %d passed, %d failed, %d skipped"
              % (self.name, total, len(self.passed), len(self.failed),
                 len(self.skipped)))
        if self.skipped:
            print("NOT ASSERTED (a claim this suite could not decide):")
            for label in self.skipped:
                print("  ~ %s" % label)
        if self.failed:
            print("FAILED:")
            for label in self.failed:
                print("  - %s" % label)
        print("PYGENTEST-RESULT " + self.result())
        return 1 if self.failed else 0
