"""_pygentest_harness — the stdlib-only execution harness for generated batchpy modules.

This is the test half of the db-router contract (docs/pygentest-plan.md §4
Phase 2b). `{{.RouterClass}}` and `{{.ModeClass}}` below carry the same names and
the same members as the production `core/db_router.py`; both halves are rendered
from the one contract, and a compile-check compares the two loaded surfaces, so
the fake cannot drift from the code it stands in for.

A suite uses four things:

    import sys
    from _pygentest_harness import Suite, {{.RouterClass}}, {{.ModeClass}}, load, normalise

    M = load("bat_px_mkr_chkr.py")               # import by path, fakes injected
    router = {{.RouterClass}}(pending=[row])     # rows served to SELECTs, FIFO
    repo = M.BatPxMkrChkrRepository(router)      # the real generated code runs
    suite = Suite("bat_px_mkr_chkr")
    ...
    sys.exit(suite.finish())

The recorder lives on the router, and is what assertions compare:

  - log:      (txn_id, normalised_sql, binds) for every attempted execute
  - txn_ends: (txn_id, had_exception) for every get_connection() block
  - commits / rollbacks: the txn ids the transaction context manager ended
  - modes:    txn_id -> the mode get_connection() was called with

One get_connection() block is one transaction, exactly as in production: a
clean WRITE exit commits, an exception rolls back and re-raises. No oracledb
and no database are involved — install() shadows both in sys.modules before
the module under test is imported, and this module imports nothing outside the
standard library on purpose (the harness is the only dependency a suite has).
"""
import importlib.util
import json
import os
import re
import sys
import types
from contextlib import contextmanager
from enum import Enum


class DatabaseError(Exception):
    """Stands in for oracledb.DatabaseError, and is what fail_on injects."""


class _BindVar:
    """Stands in for a cursor.var() bind variable (RETURNING INTO targets)."""

    def __init__(self, value=None):
        self._value = value

    def setvalue(self, value):
        self._value = value

    def getvalue(self):
        return self._value


def _binds_of(binds):
    """The bind values of either a named or a positional bind list."""
    if binds is None:
        return []
    if isinstance(binds, dict):
        return list(binds.values())
    return list(binds)


class _Cursor:
    """A recording stand-in for an oracledb cursor.

    SELECT statements are served from the router's `pending` queue: each queue
    entry answers one SELECT, a plain tuple as one row and a list as the rows
    fetchall sees. DML answers `rowcount`. A statement whose SQL contains
    RETURNING fills every var() bind with the router's `rowid`, the way the
    driver would on a real connection.
    """

    def __init__(self, conn):
        self.conn = conn
        self.router = conn.router
        self._rows = []
        self._rowid = None
        self.rowcount = 0

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return False

    @property
    def rowid(self):
        return self._rowid

    def var(self, typecode=None, size=None):
        """A bind variable, as oracledb creates for RETURNING INTO targets."""
        return _BindVar()

    def execute(self, sql, binds=None):
        statement = normalise(sql)
        self.router.log.append((self.conn.txn, statement, binds))
        if self.router._should_fail(statement, binds):
            raise DatabaseError("pygentest harness: injected failure for " + statement)
        if statement.upper().startswith("SELECT"):
            self._rows = self.router._take_rows()
            self.rowcount = len(self._rows)
        else:
            self.rowcount = self.router.default_rowcount
        if "RETURNING" in statement.upper():
            self._rowid = self.router.rowid
            for bind in _binds_of(binds):
                if isinstance(bind, _BindVar):
                    bind.setvalue(self.router.rowid)
        return self

    def executemany(self, sql, seq_of_binds):
        statement = normalise(sql)
        self.router.log.append((self.conn.txn, statement, list(seq_of_binds)))
        if self.router._should_fail(statement, seq_of_binds):
            raise DatabaseError("pygentest harness: injected failure for " + statement)
        self.rowcount = len(seq_of_binds)
        return self

    def fetchone(self):
        return self._rows.pop(0) if self._rows else None

    def fetchall(self):
        rows, self._rows = self._rows, []
        return rows

    def fetchmany(self, size=1):
        rows, self._rows = self._rows[:size], self._rows[size:]
        return rows

    def __iter__(self):
        """A real oracledb cursor is iterable, and the emitter's
        SELECT_MULTI repository method relies on it (`for row in cur`). It
        drains, exactly as fetchall() would — so a generator method holds its
        transaction open until the rows are exhausted, as it does live.
        """
        while self._rows:
            yield self._rows.pop(0)

    def close(self):
        self._rows = []


class _Connection:
    """One borrowed connection = one transaction.

    commit() and rollback() are the recorder's single points: the
    get_connection() context manager calls them on the way out, and a body
    that calls them itself is recorded just the same — an explicit commit is
    a fact the suite can assert on, not something to swallow.
    """

    def __init__(self, router, txn, mode):
        self.router = router
        self.txn = txn
        self.mode = mode

    def cursor(self):
        return _Cursor(self)

    def commit(self):
        self.router.commits.append(self.txn)

    def rollback(self):
        self.router.rollbacks.append(self.txn)

    def close(self):
        pass


