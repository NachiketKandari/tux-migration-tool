	"{{.Module}}/pkg/repo"
	controller "{{.ControllerPkg}}"
	db "{{.DBPkg}}"

	"github.com/gin-gonic/gin"
)

type {{.StructName}} struct {
	controller controller.{{.ControllerIface}}
}

type {{.IfaceName}} interface {
{{- range .Methods}}
	{{.}}({{$.CtxName}} *gin.Context)
{{- end}}
}

func {{.CtorName}}(controller controller.{{.ControllerIface}}) {{.IfaceName}} {
