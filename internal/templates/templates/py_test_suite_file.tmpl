"""{{.Module}} — pygentest suite (generated by tuxconv; docs/pygentest-plan.md §2/§4).

Four assertion tiers over the module under test, every one of them DRIVEN —
the suite imports {{.ModuleFile}}, calls its repository and service against a
fake database, and compares the (txn_id, sql, binds) the code actually
produced. Nothing here reads the source back and asserts on its text.

  Tier 1  SQL well-formedness  per constant, over the SQL this module holds
  Tier 2  repository contract  per method: statements, binds, transaction, result
  Tier 3  service lifecycle    construction, entrypoint, transaction discipline
  Tier 4  negatives            empty result, mid-flight failure, contention

Generated from the same pyplan.Plan the emitter read, so a test written from
the plan can only catch EMITTER bugs — never plan bugs, which is why this
suite runs beside sqlchk (translation) rather than instead of it.

The exit code is the gate: 0 = every check passed. A suite that does not
finish does not pass. Run it with:

    python3 <this file>

Do not hand-edit. It is rewritten on every pygentest run, and an edit is a
claim nothing checks.
"""
import inspect
import os
import sys

import _pygentest_harness as H
from _pygentest_sqlrules import RULES, check as sqlcheck

HERE = os.path.dirname(os.path.abspath(__file__))
MODULE = "{{.Module}}"
REPO = "{{.RepoName}}"
SERVICE = "{{.ClassName}}"
ENTRY = "{{.Entrypoint}}"
SOURCE = "{{.Source}}"
SHAPE = "{{.Shape}}"
BODY = "{{.BodyState}}"

M = H.load(os.path.join(HERE, "{{.ModuleFile}}"), name=MODULE)
suite = H.Suite(MODULE + " (pygentest)")
MODE = getattr(H, "{{.ModeClass}}")
# The module's own empty-result signal, resolved from the module under test
# rather than re-declared here. A method whose legacy SQLCODE guard was strict
# raises NoRowsError on an empty fetch; a tolerant or unguarded one returns
# None. Looking it up on M keeps this suite honest about what was actually
# generated: if the module stops defining it, the lookup is None and the
# strict assertions report it instead of silently passing.
NoRowsError = getattr(M, "NoRowsError", None)

print("pygentest suite for %s" % MODULE)
print("  source:     %s" % SOURCE)
print("  shape:      %s   service body: %s" % (SHAPE, BODY))
print("  rules:      %s" % ", ".join("%s %s" % (r[0], r[1]) for r in RULES))

# ---------------------------------------------------------------------------
# The plan tables, as generated. CONSTS is Tier 1's input, METHODS Tier 2's
# and the reverse index the lifecycle tier matches recorded SQL against.
# ---------------------------------------------------------------------------

CONSTS = [
{{- range .Consts}}
    {"name": "{{.Name}}", "kind": "{{.Kind}}", "binds": {{.Binds}},
     "row_shape": {{.RowShape}}, "used_by": {{.UsedBy}}},
{{- end}}
]

METHODS = [
{{- range .Methods}}
    {"name": "{{.Name}}", "kind": "{{.Kind}}", "consts": {{.Consts}},
     "binds": {{.Binds}}, "mode": "{{.Mode}}", "returns": "{{.Returns}}",
     "strict_no_rows": {{.StrictNoRowsPy}}},
{{- end}}
]

BLOCKS = [
{{- range .Blocks}}
    {"index": {{.Index}}, "name": "{{.Name}}", "methods": {{.Methods}}},
{{- end}}
]

DISPATCH = {{.Dispatch}}

# The row the fake hands back for any SELECT. Its width is irrelevant — the
# fake serves tuples verbatim — but its VALUES are recognisable in a failure.
SERVED = ("S1", 2, "S3", 4.5, "S5", 6)
ROWCOUNT = 1

findings = []


def record(rule, where, detail):
    """A machine-readable finding: the command prints these, the exit code
    carries the verdict."""
    findings.append({"rule": rule, "where": where, "detail": detail})


def sentinel(bind):
    """The value the suite passes for one bind, so a bind the method forwards
    under the wrong name shows up as a value mismatch, not as silence."""
    return "<" + bind + ">"


def want_binds(method):
    return {b: sentinel(b) for b in method["binds"]}


def statements_of(consts):
    """The normalised SQL of a method's constants, in order."""
    return [H.normalise(getattr(M, c)) for c in consts]


def call(repo, method):
    """(result, error) — the method's own return value, or why it failed. An
    iterator method is drained here so its transaction boundary is crossed."""
    fn = getattr(repo, method["name"], None)
    if fn is None:
        return None, "%s has no method %s" % (REPO, method["name"])
    try:
        got = fn(*[sentinel(b) for b in method["binds"]])
    except Exception as exc:
        return None, "%s: %s" % (type(exc).__name__, exc)
    return (list(got) if method["returns"] == "rows" else got), None


def attempt(repo, method):
    """(outcome, detail) for the failure paths: "driver" when the harness's
    DatabaseError escaped, "no_rows" when the module's own empty-result signal
    escaped, "other" for any other exception, "" when the call returned
    normally. The failure path has to be observed AS an exception, which
    call() above deliberately converts into a return value.

    "no_rows" is a distinct outcome from "other" on purpose. Both mean the
    method failed, but only one of them means it failed the way its legacy
    SQLCODE guard said it should: a read guarded by `SQLCODE != 0` is expected
    to raise on an empty result, and an unrelated exception would be a real
    defect that must not be able to pass as the expected behaviour."""
    fn = getattr(repo, method["name"], None)
    if fn is None:
        return "missing", "%s has no method %s" % (REPO, method["name"])
    try:
        got = fn(*[sentinel(b) for b in method["binds"]])
        if method["returns"] == "rows":
            list(got)
    except H.DatabaseError as exc:
        return "driver", str(exc)
    except Exception as exc:
        if NoRowsError is not None and isinstance(exc, NoRowsError):
            return "no_rows", str(exc)
        return "other", "%s: %s" % (type(exc).__name__, exc)
    return "", ""


def stmt_count(repo_cls):
    return len([n for n, _ in inspect.getmembers(repo_cls, predicate=inspect.isfunction)
                if not n.startswith("_")])


# ===========================================================================
# Tier 1 — SQL well-formedness. This is the tier that can see F1: sqlchk
# strips the INTO host list from both sides of its comparison, so a statement
# Oracle cannot execute and a hand-fixed one score identically (0 deviations).
# The rules judge the SQL text as SQL, where the INTO clause is mandatory.
# ===========================================================================

suite.section("Tier 1 — SQL well-formedness (%d constant(s))" % len(CONSTS))

for c in CONSTS:
    name = c["name"]
    sql = getattr(M, name, None)
    if not isinstance(sql, str):
        suite.check("constant %s is a module-level string" % name, False,
                    "attribute missing or not a string")
        record("T1", name, "the module does not carry this constant")
        continue
    suite.check("constant %s is executed by a repository method" % name,
                len(c["used_by"]) > 0, "nothing in the repository runs it")
    found = sqlcheck(sql, kind=c["kind"], declared_binds=c["binds"],
                     row_shape=c["row_shape"])
    hard = [f for f in found if f[0] != "SKIP"]
    for rule, message in found:
        if rule == "SKIP":
            suite.skip("%s %s" % (name, message), "the rule cannot decide this statement")
    for rule, message in hard:
        suite.check("%s %s" % (name, rule), False, message)
        record(rule, name, message)
    if not hard:
        suite.check("%s passes every well-formedness rule" % name, True)

# ===========================================================================
# Tier 2 — repository method contract. Asserted by driving the method against
# the fake and reading the recorder, never by reading the source back: a method
# that executes the wrong constant with the wrong binds is caught here even
# when its text looks perfect.
# ===========================================================================

suite.section("Tier 2 — repository method contract (%d method(s))" % len(METHODS))

repo_cls = getattr(M, REPO, None)
suite.check("the module declares %s" % REPO, repo_cls is not None)
suite.eq("{{.ModeClass}} is the one the module imported",
         getattr(M, "{{.ModeClass}}", None), MODE)

if repo_cls is not None:
    suite.eq("the repository exposes exactly the planned methods",
             stmt_count(repo_cls), len(METHODS))

for m in METHODS:
    router = H.DatabaseRouter(pending=[SERVED])
    repo = repo_cls(router) if repo_cls is not None else None
    got, error = call(repo, m)
    suite.check("%s runs against the fake database" % m["name"], error is None,
                error or "")
    if error is not None:
        record("T2", m["name"], error)
        continue

    recorded = router.log
    suite.eq("%s executes %d statement(s)" % (m["name"], len(m["consts"])),
             len(recorded), len(m["consts"]))
    suite.eq("%s executes its own constants, in order" % m["name"],
             [entry[1] for entry in recorded], statements_of(m["consts"]))
    suite.eq("%s binds exactly its signature, per statement" % m["name"],
             [entry[2] for entry in recorded],
             [want_binds(m) or None] * len(m["consts"]))

    suite.eq("%s opens exactly one transaction" % m["name"], len(router.txn_ends), 1)
    if router.txn_ends:
        txn, errored = router.txn_ends[0]
        suite.check("%s ends its transaction cleanly" % m["name"], not errored)
        suite.eq("%s runs in %s mode" % (m["name"], m["mode"]),
                 router.modes.get(txn),
                 MODE.{{.ReadMember}} if m["mode"] == "read" else MODE.{{.WriteMember}})
        suite.eq("%s keeps every statement in that one transaction" % m["name"],
                 sorted({entry[0] for entry in recorded}), [txn])
        if m["mode"] == "write":
            suite.eq("%s commits once" % m["name"], router.commits, [txn])
        else:
            suite.eq("%s commits nothing — READ borrows" % m["name"],
                     router.commits, [])
        suite.eq("%s rolls nothing back on the happy path" % m["name"],
                 router.rollbacks, [])

    if m["returns"] == "row":
        suite.eq("%s returns the served row" % m["name"], got, SERVED)
    elif m["returns"] == "rows":
        suite.eq("%s yields every served row" % m["name"], got, [SERVED])
    else:
        suite.eq("%s returns rowcount" % m["name"], got, ROWCOUNT)

# ===========================================================================
# Tier 3 — service lifecycle.
# ===========================================================================

suite.section("Tier 3 — service lifecycle (%s)" % BODY)

if repo_cls is None:
    suite.skip("the service lifecycle tier", "%s does not exist in the module" % REPO)
else:
    router = H.DatabaseRouter(pending=[SERVED])
    service = getattr(M, SERVICE)(db_router=router)
    suite.check("the service constructs with a fake router", service is not None)
    suite.eq("construction opens no transaction", router.txn_ends, [])
    suite.eq("construction executes no statement", router.log, [])
    suite.check("the service wires the generated repository",
                isinstance(getattr(service, "repo", None), repo_cls))

    entry = getattr(service, ENTRY, None)
    suite.check("the service exposes %s" % ENTRY, callable(entry))
    if callable(entry):
        params = [p for p in inspect.signature(entry).parameters.values()]
        suite.check("%s takes no required argument (the plan's entrypoint "
                    "contract)" % ENTRY,
                    all(p.default is not inspect.Parameter.empty for p in params),
                    "%s" % [p.name for p in params])

    # statement → method index. What a run CALLS is not asserted as a pass
    # (a dispatch arm may legitimately be skipped for a given row), but a
    # statement the plan does not own IS a defect: the service body reaching
    # around the repository is the seam contract broken.
    index = {}
    for m in METHODS:
        for c in m["consts"]:
            index.setdefault(H.normalise(getattr(M, c, "")), []).append(m["name"])

    if BODY == "stub":
        raised = None
        try:
            entry()
        except NotImplementedError as exc:
            raised = str(exc)
        suite.check("%s fails loudly instead of pretending to work" % ENTRY,
                    raised is not None, "the stub returned a value")
        suite.eq("...without opening a transaction", router.txn_ends, [])
        suite.eq("...and without executing a statement", router.log, [])
        record("T3", ENTRY, "service body is a stub — the lifecycle assertions "
                            "below are unproven")
        suite.skip("one transaction per record", "the service body is a stub")
        suite.skip("the fetch and the updates of a record share it",
                   "the service body is a stub")
        suite.skip("the loop terminates on an exhausted result set",
                   "the service body is a stub")
        suite.skip("the run-detail row is closed last with the rowid the insert returned",
                   "the service body is a stub")
    else:
        run = H.DatabaseRouter(pending=[SERVED, SERVED, SERVED])
        service = getattr(M, SERVICE)(db_router=run)
        # Re-bind from the NEW service: `entry` above is bound to the first
        # instance and would drive the wrong router.
        entry = getattr(service, ENTRY, None)
        outcome, error = None, None
        try:
            outcome = entry()
        except Exception as exc:
            error = "%s: %s" % (type(exc).__name__, exc)
        suite.check("%s runs to completion against a finite result set" % ENTRY,
                    error is None, error or "")
        if error is None:
            suite.check("%s returns a summary mapping" % ENTRY,
                        isinstance(outcome, dict), repr(outcome))
            suite.eq("every transaction the run opened ended inside it",
                     len(run.txn_ends), len(run.modes))
            suite.check("the run opened at least one transaction",
                        len(run.txn_ends) > 0, "nothing was executed")
            suite.eq("no transaction was left errored", run.rollbacks, [])
            if run.log:
                dml = {txn for txn, stmts in run.txs().items()
                       if any(not s.upper().startswith(("SELECT", "TRUNCATE"))
                              for s in stmts)}
                suite.eq("every transaction that wrote also committed",
                         sorted(dml), sorted(run.commits))
                suite.check("the run committed something", bool(run.commits),
                            "nothing was committed")
                suite.eq("the service body executed only planned statements",
                         [s for s in run.sqls() if s not in index], [])
            suite.skip("the fetch and the updates of a record share one transaction",
                       "per-record atomicity needs the recognised service body (G8)")
            suite.skip("the run-detail row is closed last with the rowid the insert returned",
                       "the run-detail lifecycle needs the recognised body (G7/G8)")

    for block in BLOCKS:
        suite.eq("orchestration block %d (%s) names existing methods"
                 % (block["index"], block["name"]),
                 [n for n in block["methods"] if not hasattr(repo_cls, n)], [])

# ===========================================================================
# Tier 4 — negatives. This is where migrations break: not the happy path.
# ===========================================================================

suite.section("Tier 4 — negatives")

for m in METHODS:
    if m["returns"] not in ("row", "rows"):
        continue
    router = H.DatabaseRouter()          # nothing to serve
    got, error = call(repo_cls(router), m)
    if m.get("strict_no_rows"):
        # The legacy guard read `SQLCODE != 0` (or the bare `if (SQLCODE)`
        # form): an empty result was a FAILURE there, so the method raises.
        # Asserting "does not raise" here would be asserting the opposite of
        # the source contract.
        #
        # call() stringifies the exception, so the name is matched on the
        # rendered text — via attempt(), which classifies the exception
        # itself, rather than re-parsing a string here.
        outcome, detail = attempt(repo_cls(router), m)
        suite.check("%s on an empty result set raises NoRowsError, per its strict "
                    "SQLCODE guard" % m["name"],
                    outcome == "no_rows",
                    "the module defines no NoRowsError, so the guard cannot be honoured"
                    if NoRowsError is None else detail)
        suite.eq("%s returns nothing when it raises on an empty result set" % m["name"],
                 got, None)
    else:
        suite.check("%s on an empty result set does not raise" % m["name"],
                    error is None, error or "")
        if error is None:
            suite.eq("%s on an empty result set returns %s"
                     % (m["name"], "None" if m["returns"] == "row" else "[]"),
                     got, None if m["returns"] == "row" else [])
    suite.eq("%s commits nothing when it finds nothing" % m["name"],
             router.commits, [])
    suite.eq("%s rolls nothing back when it finds nothing" % m["name"],
             router.rollbacks, [])

for m in METHODS:
    target = statements_of(m["consts"])[0]
    router = H.DatabaseRouter(pending=[SERVED], fail_on=target)
    outcome, detail = attempt(repo_cls(router), m)
    suite.check("%s propagates a driver failure to the caller" % m["name"],
                outcome == "driver",
                "the failure was swallowed" if outcome == "" else detail)
    suite.eq("%s rolled back its transaction exactly once" % m["name"],
             router.rollbacks, [1] if m["mode"] == "write" else [])
    suite.eq("%s committed nothing while failing" % m["name"], router.commits, [])
    suite.eq("%s recorded the failed attempt" % m["name"], len(router.log), 1)
    suite.eq("%s marked its transaction errored" % m["name"],
             router.txn_ends, [(1, True)])

for m in METHODS:
    if len(m["consts"]) < 2:
        continue
    stmts = statements_of(m["consts"])
    router = H.DatabaseRouter(pending=[SERVED], fail_on=stmts[-1])
    outcome, detail = attempt(repo_cls(router), m)
    suite.check("%s propagates contention on its last statement" % m["name"],
                outcome == "driver",
                "the failure was swallowed" if outcome == "" else detail)
    suite.eq("%s attempted every statement before the failure" % m["name"],
             [entry[1] for entry in router.log], stmts)
    suite.eq("%s rolled the whole transaction back once" % m["name"],
             router.rollbacks, [1])
    suite.eq("%s committed neither half" % m["name"], router.commits, [])

if DISPATCH:
    unknown = "\u0000not-a-dispatch-value"
    run = H.DatabaseRouter(pending=[unknown])
    service = getattr(M, SERVICE)(db_router=run)
    error = None
    try:
        getattr(service, ENTRY)()
    except Exception as exc:
        error = "%s: %s" % (type(exc).__name__, exc)
    suite.check("an unknown dispatch value matches no arm", error is not None,
                "the run executed %r" % (run.sqls(),))
else:
    suite.skip("an unknown dispatch value matches no arm",
               "no dispatch table is emitted yet (G7); census: %s" % DISPATCH)

suite.extra["findings"] = findings
sys.exit(suite.finish())
