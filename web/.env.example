# Local-only defaults. Copy to .env.local to override.
# Next.js anonymous telemetry — always off for this local tool.
# (Also disabled machine-wide via `npx next telemetry disable` and in
# package.json scripts + Dockerfile. Any one of these is sufficient;
# we set all three so clones, CI, and containers are covered.)
NEXT_TELEMETRY_DISABLED=1
# Server-level run config: one yaml whose models[].apiKey / database.dsn
# literals every browser run shares (job tmpdirs carry no .tuxconv.yaml, so
# without this the viewer runs on stock defaults + server env vars only).
# The CLI reads the same file via -config or from the working directory,
# so CLI and browser resolve the same keys (env vars still win over
# literals in both). Keep the pointed-at file gitignored — never commit keys.
#TUXCONV_CONFIG=../.tuxconv.yaml
